# AutoGluon TabularPredictor Configuration File
# This file contains common and advanced parameters for TabularPredictor and its fit() method.

predictor_init:
  # Mandatory: Name of the column that contains the target variable to be predicted.
  label: "target"
  
  # Directory path where trained models and artifacts will be saved.
  path: "AutogluonModels/ag-config-test"
  
  # Problem type: 'binary', 'multiclass', 'regression', 'quantile', 'softclass', or null (infer)
  # - 'binary': 2 classes
  # - 'multiclass': >2 classes
  # - 'regression': continuous target
  # - 'quantile': quantile regression
  # - 'softclass': target is a distribution of classes
  problem_type: null
  
  # Metric to optimize. If null, chosen automatically based on problem_type.
  # Available options depend on problem_type:
  # - binary: 'accuracy', 'balanced_accuracy', 'f1', 'f1_macro', 'f1_micro', 'f1_weighted', 'roc_auc', 'average_precision', 'precision', 'recall', 'log_loss', 'pac_score'
  # - multiclass: 'accuracy', 'balanced_accuracy', 'f1_macro', 'f1_micro', 'f1_weighted', 'log_loss', 'pac_score'
  # - regression: 'root_mean_squared_error', 'mean_squared_error', 'mean_absolute_error', 'median_absolute_error', 'r2', 'pearsonr', 'spearmanr', 'mean_absolute_percentage_error', 'symmetric_mean_absolute_percentage_error'
  # - quantile: 'pinball_loss'
  eval_metric: 'f1_macro'
  
  # Control output detail. 0: silent, 1: normal, 2: info, 3: debug, 4: everything.
  verbosity: 2
  
  # List of column names to ignore during training.
  # ignored_columns: ["id", "timestamp"]
  
  # Sample weight column name.
  # sample_weight: "weight"
  
  # Whether to use sample weights during evaluation.
  weight_evaluation: false

fit_args:
  # Training time limit in seconds.
  time_limit: 3600
  
  # Selection of predefined settings: 
  # - 'best_quality': Highest accuracy, uses stacking and bagging.
  # - 'high_quality': High accuracy, uses bagging.
  # - 'good_quality': Balanced accuracy and speed.
  # - 'medium_quality': Faster training, standard models.
  # - 'optimize_for_deployment': Focus on fast inference.
  # - 'interpretable': Uses simple, interpretable models.
  # - 'ignore_text': Skips automated text feature generation.
  presets: "medium_quality"
  
  # Number of folds for bagging (e.g., 5, 10). Set to 0 to disable. null = auto.
  num_bag_folds: null
  
  # Number of stacking levels (e.g., 1, 2, 3). null = auto.
  num_stack_levels: null
  
  # Whether to fit a weighted ensemble in each stack layer. (True/False)
  fit_weighted_ensemble: true
  
  # Whether to calibrate decision threshold at the end of fit (for classification).
  # Options: True, False, 'auto'
  calibrate_decision_threshold: "auto"
  
  # Number of CPU cores to use. ('auto' or integer)
  num_cpus: "auto"
  
  # Number of GPUs to use. ('auto' or integer)
  num_gpus: "auto"
  
  # Whether to include text features in feature generation. 
  # (Ignored if presets contains 'ignore_text')
  # disable_text_features: false

hyperparameters:
  # Specify which models to train and their hyperparameters.
  # Valid Keys: 'GBM' (LightGBM), 'CAT' (CatBoost), 'XGB' (XGBoost), 'RF' (Random Forest), 
  # 'XT' (Extra Trees), 'KNN' (K-Nearest Neighbors), 'LR' (Linear Regression), 
  # 'NN_TORCH' (PyTorch NN), 'FASTAI' (FastAI NN), 'AG_AUTOMM' (Multimodal), 
  # 'FT_TRANSFORMER', 'TABM', 'REALMLP', 'MITRA'
  # Example for specific models:
  GBM: {}
  NN_TORCH: {}
  CAT: {}
  RF:
    n_estimators: 100
    ag_args:
      # Common ag_args: 'name_suffix', 'name_prefix', 'priority', 'problem_types', 'stopping_metric'
      name_suffix: "_Large"
  XT: {}
  FASTAI: {}

ag_args_fit:
  # Global constraints for all models.
  # Typical keys: 'max_memory_usage_ratio', 'time_limit_per_model', 'num_cpus', 'num_gpus'
  # max_memory_usage_ratio: 0.9
  # time_limit_per_model: 600

feature_generator_args:
  # Custom settings for the AutoMLPipelineFeatureGenerator
  enable_numeric_features: true
  enable_categorical_features: true
  enable_datetime_features: true
  enable_text_special_features: true
  enable_text_ngram_features: true
  enable_raw_text_features: false
  # verbosity: 3 (higher for more detail on feature generation)
