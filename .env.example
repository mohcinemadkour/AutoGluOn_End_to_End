# ============================================================================
# ENVIRONMENT VARIABLES - Security Configuration
# ============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Audit Logging
AUDIT_LOG_DIR=./logs/audit

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
MODEL_PATH=./autogluon_churn_model_hpo

# Database Configuration (if using database for users instead of in-memory)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=churn_prediction
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# Email Configuration (for notifications, password resets, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# EMAIL_FROM=noreply@yourcompany.com

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_PERFORMANCE_MONITORING=true

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
ALLOWED_HOSTS=localhost,127.0.0.1

# Session Configuration  
SESSION_SECRET=another-secret-key-for-sessions
COOKIE_SECURE=false  # Set to true in production with HTTPS
