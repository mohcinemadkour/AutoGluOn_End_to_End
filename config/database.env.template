# SingleStore Database Configuration
# Copy this file to .env and fill in your actual credentials

# SingleStore Connection
SINGLESTORE_HOST=your-singlestore-host.com
SINGLESTORE_PORT=3306
SINGLESTORE_DATABASE=churn_db
SINGLESTORE_USER=admin
SINGLESTORE_PASSWORD=your-secure-password

# Connection Pool Settings
SINGLESTORE_POOL_SIZE=5
SINGLESTORE_MAX_OVERFLOW=10
SINGLESTORE_POOL_RECYCLE=3600

# Data Refresh Settings
DATA_REFRESH_ENABLED=true
DATA_REFRESH_INTERVAL_HOURS=1
DATA_QUALITY_THRESHOLD=70.0

# Monitoring Settings
ENABLE_DATA_MONITORING=true
METRICS_RETENTION_DAYS=90

# Alerting
ALERT_EMAIL=data-team@company.com
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
