# ============================================================================
# Docker Ignore File - Exclude unnecessary files from Docker build
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Jupyter Notebooks
*.ipynb
.ipynb_checkpoints/

# Data files
*.csv
*.xlsx
*.json
*.yaml
*.yml
!autogluon_config.yaml

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test files
test_*.py
*_test.py
tests/

# Documentation
README.md
docs/

# Images and visualizations
*.png
*.jpg
*.jpeg
*.gif

# Backup models (keep only the production model)
autogluon_churn_model/
autogluon_baseline/
*.bak
